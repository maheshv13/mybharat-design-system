{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "resolveJsonModule": true,
    "isolatedModules": true,

    "jsx": "react-jsx",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "noEmit": true
  },

  "include": [
    "src/**/*",
  ],

  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    "src/**/*.stories.*"
  ]
}