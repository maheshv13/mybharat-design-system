{
  "name": "@mybharatyouth/design-system",
  "version": "0.1.1",
  "description": "MY Bharat React Design System",
  "type": "module",

  "publishConfig": {
    "access": "public"
  },

  "main": "./dist/mybharat-design-system.cjs",
  "module": "./dist/mybharat-design-system.es.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mybharat-design-system.es.js",
      "require": "./dist/mybharat-design-system.cjs"
    },
    "./styles.css": "./dist/design-system.css"
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },

  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },

  "dependencies": {
    "react-icons": "^5.7.0"
  },

  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.7.0",
    "playwright": "latest",
    "prop-types": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "latest"
  },

  "keywords": [
    "react",
    "design-system",
    "typescript",
    "css-modules",
    "atomic-design",
    "mybharat"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/maheshv13/mybharat-design-system.git"
  },

  "homepage": "https://maheshv13.github.io/mybharat-design-system/",
  "license": "MIT"
}